---
import { backgroundSource } from "../lib/background";
import PostActions from "../components/PostActions.astro";
import AdminNav from "../components/AdminNav.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteSettings } from "../lib/posts/repo";
import { config } from "../lib/config";
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  canonical?: string;
}
const adminPath = Astro.url.pathname.replace(/\/$/, "");
const adminPage = !!Astro.locals.owner && adminPath.startsWith("/admin") && !["/admin/login", "/admin/setup"].includes(adminPath);
const site = siteSettings();
const {
  title,
  description = site.description,
  noindex = false,
  image,
  canonical,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.browserTitle}` : site.browserTitle;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, config.origin)
  .href;
---

<!doctype html>
<html lang="zh-CN" data-theme={site.theme === "dark" ? "dark" : "light"} data-default-theme={site.theme === "dark" ? "dark" : "light"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="csrf-token" content={Astro.locals.csrf} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="zh_CN" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    {image && (
      <meta property="og:image" content={new URL(image, config.origin).href} />
    )}
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline nonce={Astro.locals.nonce}>
      try {
        const v =
          localStorage.getItem("shuxin-theme") ||
          document.documentElement.dataset.defaultTheme;
        document.documentElement.dataset.theme =
          v === "dark" ? "dark" : v === "light" ? "light" : document.documentElement.dataset.defaultTheme;
      } catch {
        const v = document.documentElement.dataset.defaultTheme;
        if (v === "light" || v === "dark")
          document.documentElement.dataset.theme = v;
      }
    </script>
  </head>
  <body class:list={{ "is-admin": adminPath.startsWith("/admin") }} data-owner-authenticated={Astro.locals.owner ? "true" : undefined}>
    {backgroundSource(site) && (
      <div
        class="site-background"
        aria-hidden="true"
        data-background-source={backgroundSource(site)}
        data-background-json={
          site.backgroundMode === "bing" ||
          (site.backgroundMode === "api" && site.backgroundApiType === "json")
            ? "true"
            : "false"
        }
        data-background-field={
          site.backgroundMode === "bing" ? "url" : site.backgroundApiField
        }
        style={`opacity:${Math.min(100, Math.max(0, Number(site.backgroundOpacity) || 0)) / 100}`}
      ></div>
    )}
    <a href="#main" class="skip-link">
      跳到正文
    </a>
    <div class="page">
      <SiteHeader />
      {adminPage && (
        <div class="admin-session" aria-label="登录状态">
          <span>你好，<span data-admin-nickname>{Astro.locals.owner!.displayName}</span>。</span>
          <a href="/admin/login" class="logout-link" data-logout>退出登录</a>
        </div>
      )}
      <main id="main">
        {adminPage ? (
          <section class="admin-shell" aria-label="站长管理">
            <AdminNav />
            <div class="admin-content">
              <h1 class="admin-page-heading">{title ?? "动态管理"}</h1>
              {(adminPath === "/admin" || adminPath === "/admin/new" || adminPath.startsWith("/admin/edit/")) && <PostActions />}
              <slot />
            </div>
          </section>
        ) : <slot />}
      </main>
      <footer class="site-footer">
        <a
          href="https://github.com/5hux1n/shuxin"
          target="_blank"
          rel="noopener noreferrer"
        >
          Powered by ShuXin
        </a>
        <a href={Astro.locals.owner ? "/admin" : "/admin/login"}>
          {Astro.locals.owner ? "管理" : "站长登录"}
        </a>
      </footer>
    </div>
    <dialog id="lightbox" class="lightbox" aria-label="查看大图">
      <div class="lightbox-controls">
        <button class="text-button" data-image-prev aria-label="上一张图片">
          上一张
        </button>
        <button class="text-button" data-image-close>
          关闭
        </button>
        <button class="text-button" data-image-next aria-label="下一张图片">
          下一张
        </button>
      </div>
      <img alt="" />
      <p class="lightbox-caption"></p>
    </dialog>
    <dialog id="confirm-dialog" class="confirm" aria-labelledby="confirm-title">
      <h2 id="confirm-title">删除动态？</h2>
      <p>动态正文会被删除，文件保留在文件库中。此操作无法撤销。</p>
      <p class="notice" data-delete-notice role="status" aria-live="polite"></p>
      <div class="form-actions">
        <button class="button" data-confirm-cancel>
          取消
        </button>
        <button class="button danger" data-confirm-delete>
          删除
        </button>
      </div>
    </dialog>
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>

<script>
  import "../scripts/background";
</script>
