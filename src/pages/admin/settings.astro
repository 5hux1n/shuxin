---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { siteSettings } from "../../lib/posts/repo";
const site = siteSettings();
---

<SiteLayout title="网站设置" noindex>
  <form class="form settings-form" id="settings-form" data-logo={site.logoId}>
    <section class="form-section">
      <h2>网站信息</h2>
      <div class="form">
        <label>
          网站标题（可选）
          <input name="title" value={site.configuredTitle} maxlength="80" />
        </label>
        <label>
          网站副标题（可选）
          <textarea
            name="description"
            maxlength="300"
          >{site.description}</textarea>
        </label>
      </div>
    </section>
    <section class="form-section">
      <h2>外观设置</h2>
      <div class="form">
          <div class="logo-settings-row">
          <div class="avatar-editor" id="image-logo-editor">
            <img
              id="logo-preview"
              class="logo-preview"
              src={site.logoId ? `/media/${site.logoId}` : undefined}
              hidden={!site.logoId}
              width="54"
              height="54"
              alt="网站 Logo 预览"
            />
            <label class="button file-label">
              上传 Logo
              <input
                id="logo-file"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/gif,image/heic,image/heif,.heic,.heif"
                hidden
              />
            </label>
            <button
              class="button"
              type="button"
              id="logo-remove"
              hidden={!site.logoId}
            >
              移除 Logo
            </button>
          </div>
          <label id="text-logo-editor">
            文字 Logo
            <input
              class="text-logo"
              name="logoText"
              value={site.logoText}
              maxlength="80"
            />
          </label>

          </div>
        <label class="settings-theme">
          默认主题
          <select name="theme">
            <option value="light" selected={site.theme !== "dark"}>
              浅色
            </option>
            <option value="dark" selected={site.theme === "dark"}>
              深色
            </option>
          </select>
        </label>
        <div class="background-settings-row">
        <label>
          背景来源
          <select name="backgroundMode" id="background-mode">
            {[
              ["upload", "上传图片"],
              ["image", "在线图片"],
              ["api", "图片 API"],
              ["bing", "Bing 每日一图"],
            ].map(([value, label]) => (
              <option value={value} selected={site.backgroundMode === value}>
                {label}
              </option>
            ))}
          </select>
        </label>
        <div
          class="avatar-editor"
          id="background-upload"
          hidden={site.backgroundMode !== "upload"}
        >
          <img
            id="background-preview"
            class="background-preview"
            src={site.backgroundId ? `/media/${site.backgroundId}` : undefined}
            width="96"
            height="64"
            alt="背景预览"
            hidden={!site.backgroundId}
          />
          <label class="button file-label">
            更换背景
            <input
              id="background-file"
              type="file"
              accept="image/jpeg,image/png,image/webp"
              hidden
            />
          </label>
          <button class="button" id="background-remove" type="button">
            移除背景
          </button>
        </div>
        </div>
        <div
          id="background-online"
          hidden={!["image", "api"].includes(site.backgroundMode)}
        >
          <label>
            图片或 API 地址
            <input
              name="backgroundUrl"
              type="url"
              value={site.backgroundUrl}
              maxlength="2048"
            />
          </label>
        </div>
        <div
          id="background-api"
          class="form"
          hidden={site.backgroundMode !== "api"}
        >
          <label>
            API 返回格式
            <select name="backgroundApiType" id="background-api-type">
              <option
                value="image"
                selected={site.backgroundApiType === "image"}
              >
                图片或图片跳转
              </option>
              <option value="json" selected={site.backgroundApiType === "json"}>
                JSON
              </option>
            </select>
          </label>
          <label
            id="background-json-field"
            hidden={site.backgroundApiType !== "json"}
          >
            图片地址字段
            <input
              name="backgroundApiField"
              value={site.backgroundApiField}
              maxlength="120"
            />
            <span class="hint">
              例如 url、data.url、images.0.url。JSON API 需要允许跨域访问。
            </span>
          </label>
        </div>
        <label>
          背景不透明度{" "}
          <output id="background-value">{site.backgroundOpacity}%</output>
          <input
            id="background-opacity"
            name="backgroundOpacity"
            type="range"
            min="0"
            max="100"
            value={site.backgroundOpacity}
          />
        </label>
        <p id="background-notice" class="notice" aria-live="polite"></p>
      </div>
    </section>
    <div class="form-actions">
      <button class="button primary" type="submit">
        保存设置
      </button>
    </div>
    <p id="settings-notice" class="notice" aria-live="polite"></p>
  </form>
</SiteLayout>
