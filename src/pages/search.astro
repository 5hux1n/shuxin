---
import SiteLayout from "../layouts/SiteLayout.astro";
import TimelineEntry from "../components/TimelineEntry.astro";
import { timeline, searchCategories, timelineAttachments } from "../lib/posts/repo";
const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 200);
const matchedCategories = searchCategories(q);
const requestedCategory = Astro.url.searchParams.get("category") ?? "";
const activeCategory = matchedCategories.find(({ id }) => id === requestedCategory);
const invalidCategory = Boolean(requestedCategory && !activeCategory);
const result = q && !invalidCategory ? timeline(Astro.url.searchParams.get("cursor"), q, activeCategory?.id) : null;
if (invalidCategory) Astro.response.status = 400;
const searchLink = (category = "", cursor = "") => {
  const params = new URLSearchParams({ q });
  if (category) params.set("category", category);
  if (cursor) params.set("cursor", cursor);
  return `/search?${params}`;
};
const attachments = timelineAttachments(result?.entries.map(({ id }) => id) ?? []);
if (result?.invalid) Astro.response.status = 400;
---

<SiteLayout title="搜索" noindex>
  <a class="back" href="/">
    ← 返回首页
  </a>
  <h1 class="page-title">搜索动态</h1>
  <form class="search-form" action="/search" method="get">
    <label class="sr-only" for="q">
      搜索公开动态
    </label>
    <input
      id="q"
      name="q"
      type="search"
      value={q}
      maxlength="200"
      placeholder="搜索标题、正文或分类"
      required
    />
    <button class="button" type="submit">
      搜索
    </button>
  </form>
  {matchedCategories.length > 0 && (
    <nav class="search-category-filter" aria-label="按分类筛选搜索结果">
      <span class="search-category-label">分类</span>
      <a href={searchLink()} aria-current={!activeCategory ? "page" : undefined}>全部结果</a>
      {matchedCategories.map((category) => (
        <a href={searchLink(category.id)} aria-current={activeCategory?.id === category.id ? "page" : undefined}>{category.name}</a>
      ))}
    </nav>
  )}
  <div id="timeline">
    {result?.entries.map((post) => (
      <TimelineEntry post={post} attachments={attachments.get(post.id)} />
    ))}
  </div>
  {invalidCategory ? (
    <p class="empty">分类筛选无效，请重新选择分类。</p>
  ) : result?.invalid ? (
    <p class="empty">分页链接无效，请重新搜索。</p>
  ) : (
    q && !result?.entries.length && <p class="empty">没有找到相关动态。</p>
  )}
  {result?.cursor && (
    <div class="pagination">
      <a
        class="load-more-link"
        data-load-more
        href={searchLink(activeCategory?.id, result.cursor)}
      >
        加载更多
      </a>
    </div>
  )}
  <p class="load-status" aria-live="polite"></p>
</SiteLayout>
