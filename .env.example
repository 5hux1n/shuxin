# Public canonical origin, no trailing slash. Production must use HTTPS.
SITE_URL=http://localhost:4321
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=./data
# In production set true and put HTTPS reverse proxy in front.
COOKIE_SECURE=false
HOST=0.0.0.0
PORT=4321
